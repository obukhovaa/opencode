#!/usr/bin/env bash

set -euo pipefail

# Parse command line arguments
minor=false
while [ "$#" -gt 0 ]; do
    case "$1" in
    --minor)
        minor=true
        shift 1
        ;;
    --patch)
        minor=false
        shift 1
        ;;
    *)
        echo "Unknown parameter: $1"
        exit 1
        ;;
    esac
done

git fetch --force --tags

# Get the latest Git tag
latest_tag=$(git tag | grep -E '[0-9]' | sort -V | tail -1)

# If there is no tag, exit the script
if [ -z "$latest_tag" ]; then
    echo "No tags found"
    exit 1
fi

echo "Latest tag: $latest_tag"

# Split the tag into major, minor, and patch numbers
IFS='.' read -ra VERSION <<<"$latest_tag"

if [ "$minor" = true ]; then
    # Increment the minor version and reset patch to 0
    minor_number=${VERSION[1]}
    minor_number=$((minor_number + 1))
    new_version="${VERSION[0]}.$minor_number.0"
else
    # Increment the patch version
    patch_number=${VERSION[2]}
    patch_number=$((patch_number + 1))
    new_version="${VERSION[0]}.${VERSION[1]}.$patch_number"
fi

echo "New version: $new_version"

git tag "$new_version"
git push origin "refs/tags/$new_version"
